
# <type>(<scope>): <subject>
# │       │          └─ 小写开头，动词原形，不加句号，72 字符以内
# │       └─ 可选范围：web | storybook | ui | api | env | infra | config | deps | faq-bot | i18n
# └─ 类型：feat | fix | docs | style | refactor | perf | test | chore | build | ci | revert
#
# [可选 body] ← 空一行后写，解释 WHY（每行 ≤ 100 字符）
#
# [可选 footer]
# BREAKING CHANGE: <描述>
# Closes #<issue>
#
# ──────────────────────────────────────────────────────────────────────────────
# 示例：
#   feat(ui): add skeleton component with card variant
#   fix(faq-bot): remove nodejs runtime export for CF Workers compat
#   chore(deps): upgrade @opennextjs/cloudflare to 1.20
#   ci: add commitlint job to PR check pipeline
