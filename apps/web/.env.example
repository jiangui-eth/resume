# ── Runtime ────────────────────────────────────────────────────────────────────

# Allowed CORS origin for the dev server (Next.js runs on port 3001 locally)
CORS_ORIGIN=http://localhost:3001

# ── Build-time public vars (NEXT_PUBLIC_* are inlined at build time) ───────────

# Deployment environment — set to "preview" in Vercel dashboard for Preview environments
# Values: "development" | "preview" | "production"
NEXT_PUBLIC_ENV=development

# Canonical site URL used for sitemap and OG metadata
# In Vercel: set to the production domain for Production, leave unset for Preview
# (Preview deployments use VERCEL_URL automatically via fallback in sitemap.ts)
NEXT_PUBLIC_SITE_URL=https://jiangui-resume.vercel.app

# ── Vercel-injected (set automatically — do not set manually) ──────────────────

# Injected by Vercel on every deployment — available as process.env.VERCEL_URL
# Use for Preview URL construction: https://${process.env.VERCEL_URL}
# VERCEL_URL=<auto>

# ── OTC FAQ Bot: RAG pipeline ──────────────────────────────────────────────
# OpenAI – text-embedding-3-small (1536 dims) + gpt-4o-mini chat completion
OPENAI_API_KEY=sk-...

# Supabase – pgvector database (run scripts/db-schema.sql first)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cohere – reranker (command-r-08-2024 or rerank-english-v3.0)
COHERE_API_KEY=...
