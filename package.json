{
  "name": "jiangui-resume",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "turbo -F storybook-app storybook",
    "deploy": "turbo -F @jiangui-resume/infra deploy",
    "destroy": "turbo -F @jiangui-resume/infra destroy",
    "prepare": "husky"
  },
  "dependencies": {
    "@jiangui-resume/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@eslint-react/eslint-plugin": "catalog:",
    "@jiangui-resume/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,astro}": "eslint --fix",
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,astro,css,json,md}": "prettier --write"
  },
  "packageManager": "pnpm@11.8.0",
  "volta": {
    "node": "26.3.1"
  }
}
